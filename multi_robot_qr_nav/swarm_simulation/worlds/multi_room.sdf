<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="kidnapped_robot_world">
    <!-- Essential System Plugins for Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_type>ogre2</render_type>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer Walls (10x10m Arena) -->
    <model name="outer_walls"><static>true</static>
      <link name="wall_n"><pose>0 5 1 0 0 0</pose><collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry></visual></link>
      <link name="wall_s"><pose>0 -5 1 0 0 0</pose><collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry></visual></link>
      <link name="wall_e"><pose>5 0 1 0 0 0</pose><collision name="c"><geometry><box><size>0.2 10 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 2</size></box></geometry></visual></link>
      <link name="wall_w"><pose>-5 0 1 0 0 0</pose><collision name="c"><geometry><box><size>0.2 10 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 2</size></box></geometry></visual></link>
    </model>

    <!-- Inner Partition Walls forming 3 Rooms with Open Entrances -->
    <model name="room_partitions"><static>true</static>
      
      <!-- Room 1 (Top-Left) -->
      <!-- Horizontal Wall (Left outer wall to X=-1) -->
      <link name="r1_h"><pose>-2.95 1 1 0 0 0</pose><collision name="c"><geometry><box><size>3.9 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>3.9 0.2 2</size></box></geometry></visual></link>
      <!-- Vertical Wall (Top outer wall down to Y=3, leaving a 2m entrance) -->
      <link name="r1_v"><pose>-1 3.95 1 0 0 0</pose><collision name="c"><geometry><box><size>0.2 1.9 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 1.9 2</size></box></geometry></visual></link>

      <!-- Room 2 (Top-Right) -->
      <!-- Horizontal Wall (Right outer wall to X=1) -->
      <link name="r2_h"><pose>2.95 1 1 0 0 0</pose><collision name="c"><geometry><box><size>3.9 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>3.9 0.2 2</size></box></geometry></visual></link>
      <!-- Vertical Wall (Top outer wall down to Y=3, leaving a 2m entrance) -->
      <link name="r2_v"><pose>1 3.95 1 0 0 0</pose><collision name="c"><geometry><box><size>0.2 1.9 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 1.9 2</size></box></geometry></visual></link>

      <!-- Room 3 (Bottom-Right) -->
      <!-- Horizontal Wall (Right outer wall to X=2, leaving a 1m entrance) -->
      <link name="r3_h"><pose>3.45 -1 1 0 0 0</pose><collision name="c"><geometry><box><size>2.9 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.9 0.2 2</size></box></geometry></visual></link>
      <!-- Vertical Wall (Bottom outer wall up to Y=-1) -->
      <link name="r3_v"><pose>1 -2.95 1 0 0 0</pose><collision name="c"><geometry><box><size>0.2 3.9 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 3.9 2</size></box></geometry></visual></link>

    </model>

    <!-- Picture-Frame QR Targets Mounted Flat on Walls at Robot Camera Height (Z = 0.45m) -->
    <!-- Room 1 North Wall -->
    <include><uri>model://qr_target_1</uri><name>qr_room1</name><pose>-3 4.89 0.45 0 0 1.5708</pose></include>
    <!-- Room 2 East Wall -->
    <include><uri>model://qr_target_2</uri><name>qr_room2</name><pose>4.89 3 0.45 0 0 0</pose></include>
    <!-- Room 3 South Wall -->
    <include><uri>model://qr_target_3</uri><name>qr_room3</name><pose>3.5 -4.89 0.45 0 0 1.5708</pose></include>
    <!-- Hall West Wall -->
    <include><uri>model://qr_target_4</uri><name>qr_hall1</name><pose>-4.89 -2 0.45 0 0 0</pose></include>
    <!-- Hall South Wall -->
    <include><uri>model://qr_target_4</uri><name>qr_hall2</name><pose>-2 -4.89 0.45 0 0 1.5708</pose></include>
  </world>
</sdf>
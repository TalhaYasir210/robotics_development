<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="warehouse">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Sensors" filename="ignition-gazebo-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="ignition::gazebo::systems::Imu" filename="ignition-gazebo-imu-system"/>
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- Flat ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boundary Walls (10m x 6m room) -->
    <model name="boundary_walls">
      <static>true</static>
      <!-- Top Wall -->
      <link name="wall_top">
        <pose>0 4.0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Bottom Wall -->
      <link name="wall_bottom">
        <pose>0 -4.0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Left Wall -->
      <link name="wall_left">
        <pose>-6.0 0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 8 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Right Wall -->
      <link name="wall_right">
        <pose>6.0 0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 8 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      
      <!-- Small Room Walls (Top-Right Corner) -->
      <!-- Room Bottom Wall -->
      <link name="room_wall_bottom">
        <pose>4.5 1.0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.2 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Room Left Wall (With open entrance) -->
      <link name="room_wall_left">
        <pose>3.0 3.25 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.5 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.5 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Just 2 Shelves inside (moved further from walls) -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_left</name>
      <pose>-2.5 -0.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_right</name>
      <pose>2.5 -0.5 0 0 0 0</pose>
    </include>

    <!-- Cranes (Pallet Jacks) -->
    <include>
      <uri>model://aws_robomaker_warehouse_PalletJackB_01</uri>
      <name>pallet_jack_1</name>
      <pose>-1.5 2 0 0 0 0.5</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_PalletJackB_01</uri>
      <name>pallet_jack_2</name>
      <pose>1.5 -2 0 0 0 2.1</pose>
    </include>

    <!-- Box Piles in Diagonal Corners (Stuck to walls) -->
    <!-- Top-Left Corner -->
    <include>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <name>box_pile_1</name>
      <pose>-5.2 3.0 0 0 0 0</pose>
    </include>
    
    <!-- Bottom-Right Corner -->
    <include>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <name>box_pile_2</name>
      <pose>5.2 -3.0 0 0 0 0</pose>
    </include>

    <!-- Trash Can -->
    <include>
      <uri>model://aws_robomaker_warehouse_TrashCanC_01</uri>
      <name>trash_can</name>
      <pose>-2.0 -3.5 0 0 0 0</pose>
    </include>
    
    <!-- Small Room Contents (Top-Right) -->
    <include>
      <uri>model://aws_robomaker_warehouse_DeskC_01</uri>
      <name>office_desk</name>
      <pose>5.0 3.3 0 0 0 1.57</pose>
    </include>
    
    <!-- Bucket placed inside the room entrance, moved away from wall and rotated -->
    <include>
      <uri>model://aws_robomaker_warehouse_Bucket_01</uri>
      <name>bucket</name>
      <pose>3.6 3.2 0 0 0 3.14</pose>
    </include>

  </world>
</sdf>

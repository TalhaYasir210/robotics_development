<?xml version="1.0" ?>
<robot name="turtlebot3_waffle_pi" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Multi-robot namespacing arguments and properties -->
  <xacro:arg name="robot_name" default="tb3_1"/>
  <xacro:property name="robot_name" value="$(arg robot_name)"/>
  <xacro:property name="prefix" value="${robot_name}/"/>

  <!-- Init colour materials -->
  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
  <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="light_black"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="green"><color rgba="0.0 0.8 0.0 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.4235 0.0392 1.0"/></material>
  <material name="brown"><color rgba="0.8706 0.8118 0.7647 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>

  <!-- Base Footprint -->
  <link name="${prefix}base_footprint"/>

  <joint name="${prefix}base_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link" />
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="${prefix}base_link">
    <visual>
      <origin xyz="-0.064 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://swarm_simulation/meshes/bases/waffle_pi_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>
    <collision>
      <origin xyz="-0.064 0 0.047" rpy="0 0 0"/>
      <geometry><box size="0.266 0.266 0.050"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.064 0 0" rpy="0 0 0"/>
      <mass value="1.3729096e+00"/>
      <inertia ixx="8.7002718e-03" ixy="-4.7576583e-05" ixz="1.1160499e-04" iyy="8.6195418e-03" iyz="-3.5422299e-06" izz="1.4612727e-02" />
    </inertial>
  </link>
  <gazebo reference="${prefix}base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- Left Wheel -->
  <joint name="${prefix}wheel_left_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}wheel_left_link"/>
    <origin xyz="0.0 0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="${prefix}wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://swarm_simulation/meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.033"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05" />
    </inertial>
  </link>
  <gazebo reference="${prefix}wheel_left_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <!-- Right Wheel -->
  <joint name="${prefix}wheel_right_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}wheel_right_link"/>
    <origin xyz="0.0 -0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="${prefix}wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://swarm_simulation/meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.033"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05" />
    </inertial>
  </link>
  <gazebo reference="${prefix}wheel_right_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <!-- Casters -->
  <joint name="${prefix}caster_back_right_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}caster_back_right_link"/>
    <origin xyz="-0.177 -0.064 -0.002" rpy="0 0 0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="${prefix}caster_back_right_link">
    <collision>
      <origin xyz="0 0 0.027" rpy="0 0 0"/>
      <geometry><sphere radius="0.033"/></geometry>
    </collision>
    <inertial><mass value="0.005"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
  </link>
  <gazebo reference="${prefix}caster_back_right_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <joint name="${prefix}caster_back_left_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}caster_back_left_link"/>
    <origin xyz="-0.177 0.064 -0.002" rpy="0 0 0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="${prefix}caster_back_left_link">
    <collision>
      <origin xyz="0 0 0.027" rpy="0 0 0"/>
      <geometry><sphere radius="0.033"/></geometry>
    </collision>
    <inertial><mass value="0.005"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
  </link>
  <gazebo reference="${prefix}caster_back_left_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- Front Caster (Added for Anti-Tip Stability) -->
  <joint name="${prefix}caster_front_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}caster_front_link"/>
    <origin xyz="0.06 0 -0.002" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}caster_front_link">
    <collision>
      <origin xyz="0 0 0.027" rpy="0 0 0"/>
      <geometry><sphere radius="0.033"/></geometry>
    </collision>
    <inertial><mass value="0.005"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
  </link>
  <gazebo reference="${prefix}caster_front_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- IMU -->
  <joint name="${prefix}imu_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}imu_link"/>
    <origin xyz="0.0 0 0.068" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}imu_link"/>

  <!-- LiDAR (LDS) -->
  <joint name="${prefix}scan_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}base_scan"/>
    <origin xyz="-0.064 0 0.122" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}base_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://swarm_simulation/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry><cylinder length="0.0315" radius="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="0.114" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <!-- Camera -->
  <joint name="${prefix}camera_joint" type="fixed">
    <origin xyz="0.073 -0.011 0.084" rpy="0 0 0"/>
    <parent link="${prefix}base_link"/>
    <child link="${prefix}camera_link"/>
  </joint>
  <link name="${prefix}camera_link">
    <collision>
      <origin xyz="0.005 0.011 0.013" rpy="0 0 0"/>
      <geometry><box size="0.015 0.030 0.027"/></geometry>
    </collision>
  </link>

  <joint name="${prefix}camera_rgb_joint" type="fixed">
    <origin xyz="0.003 0.011 0.009" rpy="0 0 0"/>
    <parent link="${prefix}camera_link"/>
    <child link="${prefix}camera_rgb_frame"/>
  </joint>
  <link name="${prefix}camera_rgb_frame"/>

  <joint name="${prefix}camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="${prefix}camera_rgb_frame"/>
    <child link="${prefix}camera_rgb_optical_frame"/>
  </joint>
  <link name="${prefix}camera_rgb_optical_frame"/>

  <!-- ================================================= -->
  <!-- GAZEBO PLUGINS & SENSORS FOR ROS 2 JAZZY          -->
  <!-- ================================================= -->

  <!-- Gazebo Harmonic Diff Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <ros><namespace>/${robot_name}</namespace></ros>
      <left_joint>${prefix}wheel_left_joint</left_joint>
      <right_joint>${prefix}wheel_right_joint</right_joint>
      <wheel_separation>0.287</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <topic>/${robot_name}/cmd_vel</topic>
      <odom_topic>/${robot_name}/odom</odom_topic>
      <tf_topic>/${robot_name}/tf</tf_topic>
      <frame_id>${prefix}odom</frame_id>
      <child_frame_id>${prefix}base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- Gazebo Harmonic LiDAR Sensor Plugin -->
  <gazebo reference="${prefix}base_footprint">
    <sensor type="gpu_lidar" name="${robot_name}_lidar">
      <topic>/${robot_name}/scan</topic>
      <gz_frame_id>${prefix}base_scan</gz_frame_id>
      <pose>-0.064 0 0.132 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1440</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>
        <range><min>0.120</min><max>4.0</max><resolution>0.015</resolution></range>
      </ray>
    </sensor>
  </gazebo>

  <!-- Gazebo Harmonic Camera Sensor Plugin -->
  <gazebo reference="${prefix}base_footprint">
    <sensor type="camera" name="${robot_name}_camera">
      <topic>/${robot_name}/camera/image_raw</topic>
      <camera_info_topic>/${robot_name}/camera/camera_info</camera_info_topic>
      <gz_frame_id>${prefix}camera_link</gz_frame_id>
      <pose>0.073 -0.011 0.094 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera name="intel_realsense_r200">
        <horizontal_fov>1.085595</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.03</near><far>100</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>

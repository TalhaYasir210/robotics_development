<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="warehouse">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Sensors" filename="ignition-gazebo-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="ignition::gazebo::systems::Imu" filename="ignition-gazebo-imu-system"/>
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- Flat ground plane (no hazard tape bumps) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Creating a simple, easy to map warehouse room with standard shelves -->
    <!-- Left wall -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_1</name>
      <pose>-3 3 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_2</name>
      <pose>0 3 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_3</name>
      <pose>3 3 0 0 0 0</pose>
    </include>

    <!-- Right wall -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_4</name>
      <pose>-3 -3 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_5</name>
      <pose>0 -3 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_6</name>
      <pose>3 -3 0 0 0 0</pose>
    </include>
    
    <!-- Top wall -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_7</name>
      <pose>5 1.5 0 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_8</name>
      <pose>5 -1.5 0 0 0 1.570796</pose>
    </include>
    
    <!-- Bottom wall (Open corridor end) -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_9</name>
      <pose>-5 1.5 0 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>shelf_10</name>
      <pose>-5 -1.5 0 0 0 1.570796</pose>
    </include>
    
    <include>
      <uri>model://aws_robomaker_warehouse_PalletJackB_01</uri>
      <name>pallet_jack</name>
      <pose>-2 0 0 0 0 0.5</pose>
    </include>

  </world>
</sdf>
